@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Employee</h2>
    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete this employee?
    </div>

    <div class="card shadow-sm p-4 col-md-8">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

            <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Phone)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

            <dt class="col-sm-3 text-muted">Department</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">
                    @(Model.Department != null ? Model.Department.Name : "No Department Assigned")
                </span>
            </dd>
        </dl>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
