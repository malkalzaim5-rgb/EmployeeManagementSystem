@model EmployeeManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Department</h2>
    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete this department?
    </div>

    <div class="card shadow-sm p-4 col-md-8">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Location)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Location)</dd>
        </dl>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
