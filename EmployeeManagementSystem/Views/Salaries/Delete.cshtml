@model EmployeeManagementSystem.Models.Salary

@{
    ViewData["Title"] = "Delete Salary";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Salary Record</h2>
    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete this salary record?
    </div>

    <div class="card shadow-sm p-4 col-md-8">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Employee</dt>
            <dd class="col-sm-8 fw-semibold">
                @(Model.Employee != null ? Model.Employee.Name : "No Employee Assigned")
            </dd>

            <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.BasicSalary)</dt>
            <dd class="col-sm-8">@Model.BasicSalary.ToString("N2")</dd>

            <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Bonus)</dt>
            <dd class="col-sm-8">@Model.Bonus.ToString("N2")</dd>

            <dt class="col-sm-4 text-muted">Total Salary</dt>
            <dd class="col-sm-8 fw-bold text-success">
                @((Model.BasicSalary + Model.Bonus).ToString("N2"))
            </dd>
        </dl>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
