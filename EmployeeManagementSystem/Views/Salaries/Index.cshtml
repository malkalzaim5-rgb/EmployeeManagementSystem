@model IEnumerable<EmployeeManagementSystem.Models.Salary>

@{
    ViewData["Title"] = "Salaries List";
}

<style>
    @@media print {
        header, footer, .navbar, .no-print, .btn {
            display: none !important;
        }

        body {
            background-color: #fff !important;
            font-size: 13pt;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .table {
            border: 1px solid #dee2e6 !important;
        }

            .table th, .table td {
                border: 1px solid #dee2e6 !important;
                padding: 8px 12px !important;
            }

        .print-header {
            display: block !important;
        }
    }

    .print-header {
        display: none;
    }
</style>

<div class="container mt-4">
    <div class="print-header mb-4 text-center border-bottom pb-3">
        <h2 class="fw-bold">Employee Management System</h2>
        <h4>Official Payroll & Compensation Report</h4>
        <p class="text-muted mb-0">Generated on: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h2 class="fw-bold mb-0">Salaries Management</h2>
            <p class="text-muted mb-0">Review payroll records, basic compensation, and net totals</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-printer"></i> Print / Export PDF
            </button>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle"></i> Add New Salary
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Employee Name</th>
                        <th>@Html.DisplayNameFor(model => model.BasicSalary)</th>
                        <th>@Html.DisplayNameFor(model => model.Bonus)</th>
                        <th>Total Salary</th>
                        <th class="text-center no-print" style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(item.Employee != null ? item.Employee.Name : "No Employee Assigned")</td>
                            <td>@item.BasicSalary.ToString("N2")</td>
                            <td>@item.Bonus.ToString("N2")</td>
                            <td class="fw-bold text-success">@((item.BasicSalary + item.Bonus).ToString("N2"))</td>
                            <td class="text-center no-print">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>