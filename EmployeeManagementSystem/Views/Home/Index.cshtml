@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Dashboard";
    var salary = ViewBag.Salary as EmployeeManagementSystem.Models.Salary;
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-6 fw-bold">Employee Management System</h1>
        <p class="text-muted">Enterprise Resource & Operations Platform</p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <!-- Management Dashboard (Visible strictly to Admin and HR) -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-primary text-white text-center p-3">
                    <div class="card-body">
                        <h5 class="card-title">Departments</h5>
                        <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalDepartments</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success text-white text-center p-3">
                    <div class="card-body">
                        <h5 class="card-title">Employees</h5>
                        <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalEmployees</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-dark text-white text-center p-3">
                    <div class="card-body">
                        <h5 class="card-title">Total Payroll</h5>
                        <h2 class="display-5 fw-bold mb-0">@(((decimal)ViewBag.TotalSalaries).ToString("N2"))</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interactive Visual Analytics Chart -->
        <div class="row mb-5">
            <div class="col-md-8 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0 text-secondary text-center">Headcount Distribution by Department</h5>
                    </div>
                    <div class="card-body p-4">
                        <canvas id="departmentChart" style="max-height: 280px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <h5 class="mb-3 text-secondary">Quick Actions</h5>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
                        Manage Departments
                    </a>
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-success px-4 py-2">
                        Manage Employees
                    </a>
                    <a asp-controller="Salaries" asp-action="Index" class="btn btn-outline-dark px-4 py-2">
                        Manage Salaries
                    </a>
                </div>
            </div>
        </div>
    }
    else if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Employee Self-Service Dashboard (Visible to logged-in Employees) -->
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0"><i class="bi bi-person-badge"></i> Employee Profile & Payroll Details</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (Model != null)
                        {
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Full Name</span>
                                    <strong class="fs-5">@Model.Name</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Email Address</span>
                                    <strong>@Model.Email</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Phone</span>
                                    <strong>@(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Department</span>
                                    <span class="badge bg-secondary fs-6">@(Model.Department?.Name ?? "Unassigned")</span>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h6 class="fw-bold text-secondary mb-3">Payroll Statement</h6>
                            @if (salary != null)
                            {
                                <div class="row g-3 text-center">
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded border">
                                            <small class="text-muted d-block">Basic Salary</small>
                                            <span class="fw-bold text-dark fs-5">@salary.BasicSalary.ToString("N2")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded border">
                                            <small class="text-muted d-block">Bonus</small>
                                            <span class="fw-bold text-success fs-5">+@salary.Bonus.ToString("N2")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded border">
                                            <small class="text-muted d-block">Net Total</small>
                                            <span class="fw-bold text-primary fs-5">@((salary.BasicSalary + salary.Bonus).ToString("N2"))</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    No salary record found for your account yet.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                Logged in as <strong>@User.Identity.Name</strong>, but no employee record matches this email address in the database.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Standard Landing View for Unauthenticated Users -->
        <div class="row justify-content-center">
            <div class="col-md-8 text-center py-5 border rounded-3 bg-light shadow-sm">
                <h3 class="fw-bold text-dark mb-3">Welcome to the Portal</h3>
                <p class="text-secondary mb-4">
                    Authorized employees can view their personal records and payroll information through the self-service section.
                </p>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary px-4 py-2">Sign In to Continue</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const ctx = document.getElementById('departmentChart');
            if (ctx) {
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DeptLabels ?? new string[0]));
                const dataCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DeptCounts ?? new int[0]));

                new Chart(ctx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Staff Count',
                            data: dataCounts,
                            backgroundColor: [
                                'rgba(13, 110, 253, 0.75)',
                                'rgba(25, 135, 84, 0.75)',
                                'rgba(255, 193, 7, 0.75)',
                                'rgba(13, 202, 240, 0.75)',
                                'rgba(108, 117, 125, 0.75)'
                            ],
                            borderColor: [
                                'rgb(13, 110, 253)',
                                'rgb(25, 135, 84)',
                                'rgb(255, 193, 7)',
                                'rgb(13, 202, 240)',
                                'rgb(108, 117, 125)'
                            ],
                            borderWidth: 1.5,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1, precision: 0 }
                            }
                        }
                    }
                });
            }
        </script>
    }
}